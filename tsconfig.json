{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["node", "@playwright/test"],
    "outDir": "dist",
    "rootDir": ".",
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "faulty/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
